{
  "train_glob": "data/*.nii*",
  "output_dir": "results/diffusion_unet_smoke",
  "image_size": 256,
  "scale": 2,
  "blur_sigma": 0.65,
  "noise_sigma": 0.02,
  "slices_per_volume": 2,
  "axes": [
    "sagittal",
    "coronal",
    "axial"
  ],
  "batch_size": 1,
  "num_epochs": 1,
  "learning_rate": 0.0001,
  "weight_decay": 1e-06,
  "num_workers": 0,
  "num_diffusion_steps": 1000,
  "beta_start": 0.0001,
  "beta_end": 0.02,
  "save_every": 5,
  "random_seed": 23,
  "device": "auto"
}